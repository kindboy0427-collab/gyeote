generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  guardianPhone    String?
  createdAt        DateTime          @default(now())
  parents          Parent[]
  subscriptions    Subscription[]
  notificationLogs NotificationLog[]
  paymentLogs      PaymentLog[]
  reviews          Review[]
}

model Parent {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  name             String
  mealCheck        Boolean           @default(true)
  medication       String?
  phone            String
  kakaoId          String?
  morningTime      String            @default("09:00")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  responses        Response[]
  reports          Report[]
  messages         Message[]
  notificationLogs NotificationLog[]
}

model Response {
  id          String    @id @default(cuid())
  parentId    String
  parent      Parent    @relation(fields: [parentId], references: [id])
  date        DateTime  @default(now())
  responded   Boolean   @default(false)
  respondedAt DateTime?
  message     String?
  type        String    @default("morning")
}

model Message {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Report {
  id        String    @id @default(cuid())
  parentId  String
  parent    Parent    @relation(fields: [parentId], references: [id])
  type      String
  weekStart DateTime
  content   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])

  // monthly | yearly
  plan          String    @default("monthly")

  // KAKAO_PAY | TOSS
  provider      String    @default("TOSS")

  // active | canceled | failed | pending
  status        String    @default("active")

  // monthly: 4900, yearly: 50000
  price         Int       @default(4900)

  // Toss 자동결제용
  billingKey    String?
  customerKey   String?

  // KakaoPay 정기결제용
  sid           String?
  tid           String?

  nextBillingAt DateTime?
  lastPaidAt    DateTime?
  canceledAt    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paymentLogs   PaymentLog[]
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  parentId  String?
  parent    Parent?  @relation(fields: [parentId], references: [id])
  channel   String
  status    String
  message   String?
  error     String?
  rawData   Json?
  createdAt DateTime @default(now())
}

model PaymentLog {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider       String
  status         String
  amount         Int
  orderId        String?
  paymentKey     String?
  errorMessage   String?
  raw            Json?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}